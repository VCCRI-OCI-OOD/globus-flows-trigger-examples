{
  "name": "Globus Flows Trigger Examples",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11"
    }
  },
  "postCreateCommand": "pip install -r requirements.txt && pip install globus-cli",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.debugpy"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  },
  "mounts": [
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.globus-flows-trigger-tokens.json,target=/root/.globus-flows-trigger-tokens.json,type=bind,consistency=cached"
  ],
  "remoteEnv": {
    "GLOBUS_CLI_CLIENT_ID": "${localEnv:GLOBUS_CLI_CLIENT_ID}",
    "GLOBUS_CLI_CLIENT_SECRET": "${localEnv:GLOBUS_CLI_CLIENT_SECRET}"
  }
}
